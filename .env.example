# ==============================================================================
# Frontend Environment Variables (.env.example)
# ==============================================================================

# Client API Base (Relative path to the same-origin proxy)
VITE_API_BASE=/api

# For Vercel Deployment (Settings -> Environment Variables on Frontend project)
# ------------------------------------------------------------------------------
# Backend origin where the serverless proxy forwards requests
# Example: https://farm-products-backend.vercel.app
BACKEND_URL=

# Backend API route prefix (default is /api)
API_PREFIX=/api
